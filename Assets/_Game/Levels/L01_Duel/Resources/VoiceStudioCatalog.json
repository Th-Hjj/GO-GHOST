    {
      "key": "Handler/TutorialIntro",
      "label": "Configuration introduction 1",
      "text": "I know you must be confused, but don't worry.",
      "locked": false,
      "transcribed": false
    },
    {
      "key": "Handler/TutorialIntro2",
      "label": "Configuration introduction 2",
      "text": "I'm here to help you.",
      "locked": false,
      "transcribed": false
    },
    {
      "key": "Handler/TutorialIntro3",
      "label": "Configuration introduction 3",
      "text": "My name is “Happy”.",
      "locked": false,
      "transcribed": false
    },
    {
      "key": "Handler/TutorialIntro4",
      "label": "Configuration introduction 4",
      "text": "I'm an experimental AI installed in your brain.",
      "locked": false,
      "transcribed": false
    },
    {
      "key": "Handler/TutorialIntro5",
      "label": "Configuration introduction 5",
      "text": "You can now modify your body, so I can better assist you.",
      "locked": false,
      "transcribed": false
    },
    {
      "key": "Handler/TutorialIntro8",
      "label": "Configuration introduction 6",
      "text": "For example, you can add a rule that says...",
      "locked": false,
      "transcribed": false
    },
    {
      "key": "Handler/TutorialIntroJump",
      "label": "Configuration introduction 7",
      "text": "When there's an incoming attack, jump.",
      "locked": false,
      "transcribed": false
    },
    {
      "key": "Handler/TutorialIntroAssist",
      "label": "Configuration introduction 8",
      "text": "So I will identify incoming attacks, and make you jump at the right time.",
      "locked": false,
      "transcribed": false
    },
    {
      "key": "Handler/TutorialIntro9",
      "label": "Configuration introduction 9",
      "text": "Try adding a rule by your self.",
      "locked": false,
      "transcribed": false
    },
    {
      "key": "Handler/TutorialGoodbye",
      "label": "Configuration farewell 1",
      "text": "Unfortunately, I don't have time to explain the system to you.",
      "locked": false,
      "transcribed": false
    },
    {
      "key": "Handler/TutorialGoodbye2",
      "label": "Configuration farewell 2",
      "text": "I need to finish the Alpha Feasibility Pitch right now.",
      "locked": false,
      "transcribed": false
    },
    {
      "key": "Handler/TutorialGoodbye3",
      "label": "Configuration farewell 3",
      "text": "Good luck figuring out the body configuration system.",
      "locked": false,
      "transcribed": false
    },
    {
      "key": "Handler/TutorialGoodbye4",
