Shader "GO GHOST/Arena Haze"
{
    // Premultiplied haze generated by IndustrialArenaBackdrop. Alpha 0 adds light; alpha above 0 also dims what is behind.
    Properties
    {
        [PerRendererData] _MainTex ("Premultiplied haze", 2D) = "black" {}
    }
    SubShader
    {
        Tags { "Queue"="Transparent" "RenderType"="Transparent" }
        Cull Off ZWrite Off ZTest Always
        Blend One OneMinusSrcAlpha
        Pass
        {
            CGPROGRAM
            #pragma vertex vert
            #pragma fragment frag
            #include "UnityCG.cginc"
            sampler2D _MainTex;
            struct Varyings
            {
                float4 clip : SV_POSITION;
                float2 uv : TEXCOORD0;
                half fade : COLOR;
            };
            Varyings vert(appdata_full v)
            {
                Varyings o;
                o.clip = UnityObjectToClipPos(v.vertex);
                o.uv = v.texcoord.xy;
                o.fade = v.color.a;
                return o;
            }
            half4 frag(Varyings i) : SV_Target
            {
                return tex2D(_MainTex, i.uv) * i.fade;
            }
            ENDCG
        }
    }
}
