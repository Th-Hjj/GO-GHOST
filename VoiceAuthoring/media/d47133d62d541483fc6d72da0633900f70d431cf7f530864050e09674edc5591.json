    {
      "key": "FinalBossVoice/Line3",
      "label": "Wave 3 intro 3",
      "text": "Everything you've learned, I've already seen.",
      "locked": false,
      "transcribed": false
    },
    {
      "key": "FinalBossVoice/Line4",
      "label": "Wave 3 intro 4",
      "text": "Let's see if it's enough.",
