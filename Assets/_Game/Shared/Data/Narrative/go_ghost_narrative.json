      "speakerId": "entrance_worker",
      "text": "Hi",
      "status": "draft",
      "notes": ""
    },
    {
      "id": "npc.floor01.request.01",
      "speakerId": "maintenance_ai",
      "text": "Hello. Please don't block my way. I'm heading to the maintenance unit.",
      "status": "draft",
      "notes": ""
    },
