    {
      "id": "intervention.chandelier.plan",
      "speakerId": "inner_ai",
      "text": "Shoot down the chandelier. Climb onto it for a better position.",
      "status": "draft",
      "notes": ""
    },
    {
      "id": "intervention.chandelier.execute",
      "speakerId": "inner_ai",
      "text": "System approval granted. Firing.",
      "status": "draft",
      "notes": ""
    },
