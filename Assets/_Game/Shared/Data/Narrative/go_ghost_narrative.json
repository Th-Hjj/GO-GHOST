    },
    {
      "id": "npc.floor01.restored.01",
      "speakerId": "maintenance_ai",
      "text": "Hello there! I'm the Maintenance robot. Nice to meet you!",
      "status": "draft",
      "notes": ""
    },
    {
      "id": "npc.floor01.preserved.01",
      "speakerId": "maintenance_ai",
      "text": "Huh. Did you interrupt the reset?",
      "status": "draft",
      "notes": ""
    },
    {
      "id": "boss.p1.intro.01",
      "speakerId": "puppeteer",
      "text": "Hello there, officer. I'm sorry, but please turn back now.",
      "status": "draft",
      "notes": ""
    },
    {
      "id": "boss.p1.choice.reply",
      "speakerId": "player",
      "text": "I'm sorry too. Please step aside. I need to get through.",
      "status": "draft",
      "notes": ""
    },
    {
      "id": "boss.p1.ai_warning.01",
      "speakerId": "inner_ai",
      "text": "An attack is coming.",
      "status": "draft",
      "notes": ""
    },
    {
      "id": "npc.floor50.context.01",
      "speakerId": "floor50_npc",
      "text": "Hello. Do you have an appointment?",
      "status": "draft",
      "notes": ""
    },
    {
      "id": "npc.floor50.context.02",
      "speakerId": "player",
      "text": "Ah, haha.",
      "status": "draft",
      "notes": ""
    },
    {
      "id": "npc.floor50.context.03",
      "speakerId": "player",
      "text": "NO.",
      "status": "draft",
      "notes": ""
    },
    {
      "id": "npc.floor50.context.04",
      "speakerId": "floor50_npc",
      "text": "One moment, please.",
      "status": "draft",
      "notes": ""
    },
    {
      "id": "npc.floor50.context.05",
      "speakerId": "floor50_npc",
      "text": "Security, this is the 50th-floor front desk...",
      "status": "draft",
      "notes": ""
    },
    {
      "id": "npc.floor50.after.survived.01",
      "speakerId": "floor50_npc",
      "text": "...The elevator is over there.",
      "status": "draft",
      "notes": ""
    },
    {
      "id": "npc.floor50.after.dead_player.01",
      "speakerId": "inner_ai",
      "text": "The elevator is ahead.",
      "status": "draft",
      "notes": ""
    },
    {
      "id": "npc.floor50.after.dead_ai.01",
      "speakerId": "inner_ai",
      "text": "The elevator is ahead.",
      "status": "draft",
      "notes": ""
    },
    {
      "id": "boss.p2.intro.01",
      "speakerId": "puppeteer",
      "text": "I'm getting more and more interested in you, officer.",
      "status": "draft",
      "notes": ""
    },
    {
      "id": "boss.p2.intro.02",
      "speakerId": "puppeteer",
      "text": "If I'm not mistaken, there are two minds in that head of yours.",
      "status": "draft",
      "notes": ""
    },
    {
      "id": "boss.p2.choice.why",
      "speakerId": "player",
      "text": "Why do you...",
      "status": "draft",
      "notes": ""
    },
    {
      "id": "boss.p2.choice.deny_ai_consciousness",
      "speakerId": "player",
      "text": "That's not consciousness.",
      "status": "draft",
      "notes": ""
    },
    {
      "id": "boss.p2.ai_warning.01",
      "speakerId": "inner_ai",
      "text": "Watch out. An attack is coming.",
      "status": "draft",
      "notes": ""
    },
    {
      "id": "npc.floor99.security.01",
      "speakerId": "security99",
      "text": "Intruder detected. Order from the CEO: eliminate the intruder.",
      "status": "draft",
      "notes": ""
    },
    {
      "id": "npc.floor99.ai_warning.01",
      "speakerId": "inner_ai",
      "text": "Uh, you probably already know this, but...",
      "status": "draft",
      "notes": ""
    },
    {
      "id": "npc.floor99.ai_warning.02",
      "speakerId": "inner_ai",
      "text": "An attack is coming!",
      "status": "draft",
      "notes": ""
    },
